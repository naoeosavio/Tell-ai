# Ignore everything by default
*

# Re-include distribution output and metadata
!examples/*
!examples/
!docs/examples/*
!docs/*
!docs/
!test/*
!test/
!package.json
!README*
!LICENSE*
!.gitignore
!tsconfig*
!biome*
!tsup*
!CHANGELOG*
!AGENTS.md
!task.md
!*.sh
!bun.lock

# Monorepo workspace packages
!packages/
!packages/*/
!packages/**/src/
!packages/**/src/*
!packages/*/package.json
!packages/*/tsconfig.json
!packages/*/tsup.config.ts
packages/*/dist/
