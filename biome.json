{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/dist/**", "!**/node_modules/**", "!**/test/.tmp/**", "!**/.tell/**", "!**/coverage/**"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "recommended": true,
        "noBarrelFile": "off",
        "noReExportAll": "error"
      },
      "complexity": {
        "recommended": true,
      "useLiteralKeys": "off"
      },
      "correctness": { "recommended": true, "useImportExtensions": "off" },
      "suspicious": "off",
      "style": {
        "recommended": true,
        "useImportType": "error",
        "useNodejsImportProtocol": "off"
      },
      "nursery": {
        "recommended": true,
        "noImportCycles": "off",
        "useExplicitType": "off",
        "useMaxParams": {
          "level": "warn",
          "options": { "max": 5 }
        }
      },
      "security": "on",
      "a11y": "on"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/src/exec.ts",
        "packages/core/src/paths.ts",
        "packages/core/src/sdk-config.ts",
        "packages/core/src/project-context.ts",
        "packages/cli/src/Tell.ts",
        "packages/cli/src/core-adapters.ts",
        "packages/cli/src/env.ts",
        "packages/cli/src/mentions.ts",
        "packages/cli/src/history.ts",
        "packages/cli/src/tellrc.ts",
        "packages/web/src/server/server.ts",
        "packages/web/src/server/session.ts",
        "packages/web/src/server/context-builder.ts",
        "packages/web/src/server/cli-args.ts",
        "packages/web/src/server/pty-policy.ts",
        "packages/web/src/server/chain-store.ts",
        "packages/web/src/server/pty.ts",
        "packages/web/vite.config.ts"
      ],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "lineEnding": "lf",
    "indentWidth": 2,
    "lineWidth": 120,
    "expand": "auto",
    "bracketSpacing": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "useEditorconfig": true
  },
    "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
