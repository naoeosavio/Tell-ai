{
  "name": "tell-ai",
  "version": "0.5.0",
  "description": "One-shot terminal assistant",
  "license": "GPL-3.0",
  "main": "./dist/Tell.js",
  "bin": {
    "tell": "dist/Tell.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && chmod +x dist/Tell.js",
    "prepare": "bun run build",
    "lint": "tsc -p tsconfig.json",
    "format": "biome check --write src",
    "check": "biome check src",
    "ci": "npm run lint && npm run check && npm run build"
  },
  "dependencies": {
    "@tell-ai/sdk": "workspace:*",
    "commander": "15.0.0"
  }
}
