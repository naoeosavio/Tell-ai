# Tell Web — environment example. Copy to .env and fill what you use.
# The file is ignored unless TELL_TRUST_WORKSPACE_ENV=true is set before boot.
# Server reads: PORT (or --port), TELL_MODEL (or -m), TELL_TOKEN,
# TELL_ALLOWED_HOSTS, vendor keys.

# Server
PORT="3000"
TELL_MODEL="d"
# Opt-in API auth: when set, /api/* (except /api/config) requires
# `Authorization: Bearer <token>` and the terminal WS requires ?token=<token>.
TELL_TOKEN=""
# Comma-separated public hostnames accepted by the HTTP and terminal WS
# boundaries. localhost and IP literals are always accepted.
TELL_ALLOWED_HOSTS=""
# Terminal scrollback budget per pane, in chars (default 262144 = 256KB).
TELL_SCROLLBACK_MAX=""

# Model vendor keys (only the vendors you use). Aliases live in packages/sdk/src/models.ts.
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""
ALIBABA_API_KEY=""
ZHIPU_API_KEY=""
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY=""
MOONSHOTAI_API_KEY=""
META_API_KEY=""
MIMO_API_KEY=""

Note: @types/ws@8.18.1 is the latest release of types for ws 8.x
# (covers ws@8.21.3; there is no @types/ws 8.21.x).